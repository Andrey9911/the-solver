    {
      "parameters": {
        "jsCode": "const triggerData = $('Telegram Trigger').first().json;\nconst searchResult = $input.first().json;\nconst chatId = triggerData.message?.chat?.id;\n\nlet text = '🔍 Результаты поиска каналов:\\n\\n';\n\nif (searchResult.error) {\n  text = `❌ Ошибка: ${searchResult.error}`;\n} else if (!searchResult.channels || searchResult.channels.length === 0) {\n  text = 'По твоему запросу ничего не найдено 😕';\n} else {\n  searchResult.channels.slice(0, 15).forEach((ch, i) => {\n    const username = ch.username ? `@${ch.username}` : ch.title || 'Без username';\n    const link = ch.username ? `https://t.me/${ch.username}` : '';\n    text += `${i + 1}. ${ch.title || 'Канал'}\\n   ${username} ${link}\\n\\n`;\n  });\n  if (searchResult.channels.length > 15) {\n    text += `... и ещё ${searchResult.channels.length - 15} каналов`;\n  }\n}\n\nreturn { json: { chatId, text } };"
      },
      "type": "n8n-nodes-base.code",
